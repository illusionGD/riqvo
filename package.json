{
  "name": "riqvo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "env:init": "node scripts/setup.mjs",
    "infra:up": "docker compose up -d --wait --wait-timeout 120",
    "infra:stop": "docker compose stop",
    "db:migrate": "pnpm --filter @riqvo/api db:migrate",
    "db:status": "pnpm --filter @riqvo/api db:status",
    "dev": "concurrently --kill-others --names api,web,runner \"pnpm --filter @riqvo/api dev\" \"pnpm --filter @riqvo/web dev\" \"pnpm --filter @riqvo/runner dev\"",
    "build": "pnpm -r build",
    "lint": "eslint apps scripts tests eslint.config.mjs --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "format:check": "prettier --check .",
    "test": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "prettier": "3.9.10",
    "playwright": "1.64.1",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.0"
  }
}
