{
  "name": "riqvo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "env:init": "node scripts/setup.mjs",
    "infra:up": "docker compose up -d --wait --wait-timeout 120",
    "infra:stop": "docker compose stop",
    "db:migrate": "pnpm --filter @riqvo/server db:migrate",
    "db:status": "pnpm --filter @riqvo/server db:status",
    "dev": "concurrently --kill-others --names server,web,runner \"pnpm --filter @riqvo/server dev\" \"pnpm --filter @riqvo/web dev\" \"pnpm --filter @riqvo/runner dev\"",
    "fixture:start": "pnpm --filter @riqvo/test-site build && concurrently --kill-others --names test,preprod \"node apps/test-site/dist/main.js --port=4174 --environment=test\" \"node apps/test-site/dist/main.js --port=4175 --environment=preprod\"",
    "build": "pnpm -r build",
    "lint": "eslint apps packages scripts tests eslint.config.mjs --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "format:check": "prettier --check .",
    "test": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "pc:start": "pnpm --filter @riqvo/runner... build && pnpm --filter @riqvo/web build && node apps/runner/dist/pc-main.js"
  },
  "devDependencies": {
    "@riqvo/contracts": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "prettier": "3.9.10",
    "playwright": "1.64.1",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.0",
    "@riqvo/driver-playwright": "workspace:*"
  }
}
