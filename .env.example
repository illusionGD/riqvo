# Run pnpm env:init to create .env with random local database passwords.
# Used by API, migrations and Docker Compose. Do not commit .env.
API_HOST=127.0.0.1
API_PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=riqvo
MYSQL_USER=riqvo
MYSQL_PASSWORD=GENERATED_BY_SETUP
MYSQL_ROOT_PASSWORD=GENERATED_BY_SETUP
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
# Resolved relative to this repository, regardless of process working directory.
ARTIFACT_DIR=.local/artifacts
# Development server only; browser uses same-origin /api, not private credentials.
WEB_HOST=127.0.0.1
WEB_PORT=5173
WEB_API_PROXY_TARGET=http://127.0.0.1:3000
