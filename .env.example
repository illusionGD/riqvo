# 运行 pnpm env:init 创建 .env，并生成随机本地数据库密码。
# 供 API、迁移和 Docker Compose 使用；不要提交 .env。
API_HOST=127.0.0.1
API_PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=riqvo
MYSQL_USER=riqvo
MYSQL_PASSWORD=GENERATED_BY_SETUP
MYSQL_ROOT_PASSWORD=GENERATED_BY_SETUP
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
# 始终相对于仓库根目录解析，不受进程工作目录影响。
ARTIFACT_DIR=.local/artifacts
# 仅用于开发服务器；浏览器通过同源 /api 访问，不使用服务器私有凭据。
WEB_HOST=127.0.0.1
WEB_PORT=5173
WEB_API_PROXY_TARGET=http://127.0.0.1:3000
