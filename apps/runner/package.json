{
  "name": "@riqvo/runner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc-watch --onSuccess \"node --env-file=../../.env.runner dist/main.js\"",
    "start": "node --env-file=../../.env.runner dist/main.js",
    "check": "node --env-file=../../.env.runner dist/main.js --check"
  },
  "dependencies": {
    "zod": "4.6.7",
    "@riqvo/driver-playwright": "workspace:*",
    "@riqvo/contracts": "workspace:*",
    "playwright": "1.64.1"
  }
}
